# ── Modus ──────────────────────────────────────────────────────────────────
# fixture: keine Netzwerkzugriffe, Demo-Daten aus fixtures/scans/
# live:    passive Sammlung von der öffentlichen Website des Unternehmens
SCAN_MODE=fixture

# ── Datenbank (Supabase) ───────────────────────────────────────────────────
# Ohne diese Variablen läuft die App im lokalen Datei-Modus (.data/db.json) –
# perfekt für die Demo ohne Supabase-Projekt. Für Produktion: Projekt
# anlegen, Migrationen aus supabase/migrations/ ausführen und eintragen.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Scan-Ausführung ────────────────────────────────────────────────────────
# Öffentliche Basis-URL (Netlify/Vercel); für localhost: http://localhost:3000
SITE_URL=http://localhost:3000
# Geheimnis für den Scan-Runner (Background-Funktion / Worker-Route)
SCAN_RUNNER_SECRET=change-me
# true = Berichte werden direkt freigegeben; false = Pilotmodus, Freigabe in /admin
AUTO_RELEASE=true

# ── Admin (Pilotmodus) ─────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# ── E-Mail (optional) ──────────────────────────────────────────────────────
# Ohne API-Key wird der Berichts-Link nach dem Scan auf dem Bildschirm angezeigt.
RESEND_API_KEY=
RESEND_FROM=NexusScope <noreply@example.com>

# ── KI-Scope-Check (optional) ──────────────────────────────────────────────
# LLM-Richtungsabschätzung (Bericht-Abschnitt 2). Ohne API-Key läuft der Scan
# ohne den Abschnitt; Fehler überspringen den Abschnitt, niemals den Scan.
ANTHROPIC_API_KEY=
SCOPE_CHECK_ENABLED=true
SCOPE_CHECK_MODEL=claude-sonnet-4-6

# ── Sammlung ───────────────────────────────────────────────────────────────
# Browser-Treiber (nur für JS-rendered Rechtsseiten) – standardmäßig aus.
BROWSER_DRIVER_ENABLED=false
# Lokaler Chromium-Pfad für die PDF-Funktion bei `netlify dev` (optional)
PUPPETEER_EXECUTABLE_PATH=
